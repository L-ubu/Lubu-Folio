---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 — Not Found">
  <div class="container">
    <div class="glitch" data-text="404">404</div>
    <p class="subtitle">Page not found</p>
    <p class="hint">But you found something else...</p>
    <a href="/" class="back">← back to hub</a>
  </div>
  <!-- FLAG{four_oh_four} -->
</Layout>

<style>
  .container {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    background: #050505;
    font-family: 'JetBrains Mono', monospace;
    text-align: center;
    padding: 2rem;
  }

  .glitch {
    font-size: clamp(6rem, 20vw, 12rem);
    font-weight: 700;
    color: #f5f5f5;
    position: relative;
    animation: glitch 3s infinite;
  }

  .glitch::before,
  .glitch::after {
    content: attr(data-text);
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .glitch::before {
    color: #5ccfcf;
    animation: glitch-shift 2s infinite;
    clip-path: polygon(0 0, 100% 0, 100% 50%, 0 50%);
    transform: translate(-3px);
  }

  .glitch::after {
    color: #d46a6a;
    animation: glitch-shift 2.5s infinite reverse;
    clip-path: polygon(0 50%, 100% 50%, 100% 100%, 0 100%);
    transform: translate(3px);
  }

  html[data-motion="reduced"] .glitch,
  html[data-motion="reduced"] .glitch::before,
  html[data-motion="reduced"] .glitch::after {
    animation: none;
  }

  .subtitle {
    color: #6a6a78;
    font-size: 1.2rem;
    margin-top: 1rem;
  }

  .hint {
    color: #3a8a8a;
    font-size: 0.85rem;
    margin-top: 0.5rem;
    opacity: 0.6;
  }

  .back {
    color: #5ccfcf;
    text-decoration: none;
    margin-top: 2rem;
    font-size: 0.9rem;
    transition: opacity 0.2s;
  }

  .back:hover {
    opacity: 0.7;
  }

  @keyframes glitch {
    0%, 90%, 100% { transform: none; }
    92% { transform: skew(-2deg); }
    94% { transform: skew(1deg); }
    96% { transform: skew(-1deg); }
    98% { transform: none; }
  }

  @keyframes glitch-shift {
    0%, 90%, 100% { transform: translate(0); }
    92% { transform: translate(-3px, 1px); }
    94% { transform: translate(2px, -1px); }
    96% { transform: translate(-1px, 2px); }
    98% { transform: translate(1px, -1px); }
  }
</style>
