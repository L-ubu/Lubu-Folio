---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/portfolio/Hero.astro';
import About from '../components/portfolio/About.astro';
import Projects from '../components/portfolio/Projects.astro';
import SkillsConstellation from '../components/portfolio/SkillsConstellation.jsx';
import Experience from '../components/portfolio/Experience.astro';
import Contact from '../components/portfolio/Contact.astro';
import CustomCursor from '../components/shared/CustomCursor.jsx';
import AchievementToast from '../components/shared/AchievementToast.jsx';
import AccentPicker from '../components/shared/AccentPicker.jsx';
import BackToHub from '../components/shared/BackToHub.jsx';
import ScrollProgress from '../components/shared/ScrollProgress.jsx';
import SoundToggle from '../components/shared/SoundToggle.jsx';
import SectionObserver from '../components/shared/SectionObserver.jsx';
---

<Layout title="Lubu | Portfolio">
  <CustomCursor client:only="react" />
  <ScrollProgress client:only="react" />
  <SoundToggle client:only="react" />
  <AccentPicker client:only="react" />
  <BackToHub client:only="react" />
  <AchievementToast client:only="react" />
  <SectionObserver client:only="react" />

  <nav class="portfolio-nav" id="portfolio-nav">
    <a href="#hero" class="nav-dot" data-nav="hero" title="Home">
      <span class="nav-label">Home</span>
    </a>
    <a href="#about" class="nav-dot" data-nav="about" title="About">
      <span class="nav-label">About</span>
    </a>
    <a href="#projects" class="nav-dot" data-nav="projects" title="Projects">
      <span class="nav-label">Projects</span>
    </a>
    <a href="#skills" class="nav-dot" data-nav="skills" title="Skills">
      <span class="nav-label">Skills</span>
    </a>
    <a href="#experience" class="nav-dot" data-nav="experience" title="Experience">
      <span class="nav-label">Experience</span>
    </a>
    <a href="#contact" class="nav-dot" data-nav="contact" title="Contact">
      <span class="nav-label">Contact</span>
    </a>
  </nav>

  <main>
    <Hero />
    <About />
    <Projects />
    <SkillsConstellation client:only="react" />
    <Experience />
    <Contact />
  </main>
</Layout>

<script>
  const sections = document.querySelectorAll('[data-section]');
  const dots = document.querySelectorAll('.nav-dot');

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const id = entry.target.dataset.section;
          dots.forEach((dot) => {
            dot.classList.toggle('active', dot.dataset.nav === id);
          });
        }
      });
    },
    { threshold: 0.3 }
  );

  sections.forEach((s) => observer.observe(s));
</script>

<style>
  main {
    position: relative;
    z-index: 1;
  }

  .portfolio-nav {
    position: fixed;
    right: 20px;
    top: 50%;
    transform: translateY(-50%);
    z-index: 50;
    display: flex;
    flex-direction: column;
    gap: 14px;
    align-items: flex-end;
  }

  @media (max-width: 768px) {
    .portfolio-nav { display: none; }
  }

  .nav-dot {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    cursor: none;
  }

  .nav-label {
    font-family: var(--font-mono);
    font-size: 10px;
    color: transparent;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    transition: color 0.3s;
    white-space: nowrap;
  }

  .nav-dot:hover .nav-label {
    color: var(--color-text-dim);
  }

  .nav-dot::after {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #333;
    transition: all 0.3s;
    flex-shrink: 0;
  }

  .nav-dot:hover::after {
    background: var(--color-text-dim);
    transform: scale(1.3);
  }

  .nav-dot.active::after {
    background: var(--color-accent);
    box-shadow: 0 0 10px var(--color-accent-dim);
    transform: scale(1.3);
  }
</style>
