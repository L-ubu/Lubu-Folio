---
import { projects } from '../../data/projects';
---

<section id="projects" class="projects" data-section="projects">
  <div class="projects__container">
    <div class="projects__header scroll-reveal">
      <h2 class="projects__title" data-translate="projects-title">Projects</h2>
      <p class="projects__subtitle" data-translate="projects-subtitle">Things I build when I should be sleeping</p>
    </div>

    <div class="projects__grid">
      {projects.map((project, i) => (
        <article
          class={`project-card project-card--${project.size} scroll-reveal`}
          style={`--card-accent: ${project.color}; --reveal-delay: ${i * 0.08}s`}
          data-hover-effect={project.hoverEffect}
        >
          <div class="project-card__glow"></div>
          <div class="project-card__content">
            <div class="project-card__header">
              <h3 class="project-card__title" data-translate={`project-${project.id}-title`}>{project.title}</h3>
              <span class={`project-card__status project-card__status--${project.status}`}>
                {project.status}
              </span>
            </div>
            <p class="project-card__desc" data-translate={`project-${project.id}-desc`}>{project.description}</p>
            <div class="project-card__tech">
              {project.tech.map(t => (
                <span class="project-card__tag">{t}</span>
              ))}
            </div>
            {project.links && Object.keys(project.links).length > 0 && (
              <div class="project-card__links">
                {Object.entries(project.links).map(([type, url]) => (
                  <a href={url} target="_blank" rel="noopener" class="project-card__link" data-cursor-hover>
                    {type === 'live' ? '↗ Live' : type === 'github' ? '⌂ GitHub' : type === 'gitlab' ? '◈ GitLab' : `↗ ${type}`}
                  </a>
                ))}
              </div>
            )}
          </div>
          <div class="project-card__effect" aria-hidden="true"></div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('.project-card').forEach((card) => {
    const effect = card.dataset.hoverEffect;
    const effectEl = card.querySelector('.project-card__effect');
    if (!effectEl) return;

    card.addEventListener('mouseenter', () => {
      switch (effect) {
        case 'brain-pulse':
          effectEl.innerHTML = '<div class="fx-pulse">🧠</div>';
          break;
        case 'terminal-type':
          effectEl.innerHTML = '<div class="fx-terminal">$ tup all<span class="fx-cursor">█</span></div>';
          break;
        case 'dice-roll':
          effectEl.innerHTML = '<div class="fx-dice">🎲</div>';
          break;
        case 'slime-merge':
          effectEl.innerHTML = '<div class="fx-slime">🟢🟢→🟩</div>';
          break;
        case 'glitch':
          effectEl.innerHTML = '<div class="fx-glitch">01101</div>';
          break;
        case 'waveform':
          effectEl.innerHTML = '<div class="fx-wave">🎤 ░▒▓█▓▒░</div>';
          break;
        case 'music-wave':
          effectEl.innerHTML = '<div class="fx-music">♪♫♬</div>';
          break;
        case 'flag-wave':
          effectEl.innerHTML = '<div class="fx-flag">⚜️</div>';
          break;
      }
    });

    card.addEventListener('mouseleave', () => {
      effectEl.innerHTML = '';
    });
  });
</script>

<style>
  .projects {
    padding: 8rem 2rem;
    position: relative;
  }

  .projects__container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .projects__header {
    margin-bottom: 4rem;
  }

  .projects__title {
    font-size: clamp(2rem, 5vw, 3.5rem);
  }

  .projects__subtitle {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin-top: 0.5rem;
  }

  .projects__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: minmax(200px, auto);
    gap: 16px;
  }

  @media (max-width: 1024px) {
    .projects__grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 640px) {
    .projects__grid { grid-template-columns: 1fr; }
  }

  .project-card--large {
    grid-column: span 2;
    grid-row: span 2;
  }

  .project-card--medium {
    grid-column: span 2;
  }

  .project-card {
    position: relative;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .project-card:hover {
    border-color: var(--card-accent);
    transform: translateY(-4px);
    box-shadow: 0 8px 40px color-mix(in srgb, var(--card-accent) 20%, transparent);
  }

  .project-card__glow {
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle at center, var(--card-accent), transparent 70%);
    opacity: 0;
    transition: opacity 0.5s;
    pointer-events: none;
  }

  .project-card:hover .project-card__glow {
    opacity: 0.04;
  }

  .project-card__content {
    position: relative;
    z-index: 1;
  }

  .project-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .project-card__title {
    font-family: var(--font-heading);
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .project-card__status {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    padding: 3px 8px;
    border-radius: 999px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .project-card__status--active {
    background: #22c55e20;
    color: #22c55e;
  }

  .project-card__status--wip {
    background: #f59e0b20;
    color: #f59e0b;
  }

  .project-card__status--testing {
    background: #f43f5e20;
    color: #f43f5e;
  }

  .project-card__status--done {
    background: #3b82f620;
    color: #3b82f6;
  }

  .project-card__desc {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--color-text-dim);
    margin-bottom: 1rem;
  }

  .project-card__tech {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .project-card__tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    padding: 3px 8px;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    color: var(--color-text-muted);
  }

  .project-card__links {
    display: flex;
    gap: 8px;
    margin-top: 0.75rem;
  }

  .project-card__link {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    padding: 4px 10px;
    border: 1px solid var(--color-border);
    border-radius: 6px;
    color: var(--color-text-dim);
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .project-card__link:hover {
    border-color: var(--card-accent);
    color: var(--card-accent);
    background: color-mix(in srgb, var(--card-accent) 8%, transparent);
  }

  .project-card__effect {
    position: absolute;
    bottom: 1rem;
    right: 1rem;
    font-size: 1.5rem;
    z-index: 2;
    pointer-events: none;
  }

  :global(.fx-pulse) {
    animation: fxPulse 0.6s ease-in-out infinite alternate;
    font-size: 2rem;
  }

  :global(.fx-terminal) {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: #22c55e;
  }

  :global(.fx-cursor) {
    animation: blink 0.8s step-end infinite;
  }

  :global(.fx-dice) {
    font-size: 2rem;
    animation: fxSpin 0.5s ease-in-out;
  }

  :global(.fx-slime) {
    font-size: 1rem;
    animation: fxPulse 0.4s ease-in-out infinite alternate;
  }

  :global(.fx-glitch) {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: #f43f5e;
    animation: fxGlitch 0.3s steps(3) infinite;
  }

  :global(.fx-wave) {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: #f59e0b;
  }

  :global(.fx-music) {
    font-size: 1.5rem;
    animation: fxFloat 1s ease-in-out infinite;
  }

  :global(.fx-flag) {
    font-size: 1.5rem;
    animation: fxWave 0.6s ease-in-out infinite alternate;
  }

  @keyframes fxPulse {
    from { transform: scale(1); }
    to { transform: scale(1.2); }
  }

  @keyframes fxSpin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(720deg); }
  }

  @keyframes fxGlitch {
    0% { transform: translate(0); }
    33% { transform: translate(-2px, 1px); }
    66% { transform: translate(2px, -1px); }
    100% { transform: translate(0); }
  }

  @keyframes fxFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }

  @keyframes fxWave {
    from { transform: rotate(-5deg); }
    to { transform: rotate(5deg); }
  }

  @keyframes blink {
    50% { opacity: 0; }
  }

</style>
