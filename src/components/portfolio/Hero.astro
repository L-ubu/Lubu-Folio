---
---

<section id="hero" class="hero" data-section="hero">
  <canvas id="hero-particles" class="hero__canvas"></canvas>

  <div class="hero__content">
    <div class="hero__name-wrapper">
      <h1 class="hero__name" data-name-click>
        {'LUCA VANDENWEGHE'.split('').map((char, i) => (
          <span
            class="hero__letter"
            style={`--i: ${i}; --delay: ${i * 0.04}s`}
          >
            {char === ' ' ? '\u00A0' : char}
          </span>
        ))}
      </h1>
    </div>

    <div class="hero__subtitle">
      <span class="hero__role" id="role-text" data-translate="hero-role">Creative Developer</span>
      <span class="hero__cursor-blink">|</span>
    </div>
  </div>

  <div class="hero__scroll-hint">
    <div class="hero__scroll-line"></div>
    <span data-translate="scroll-hint">scroll</span>
  </div>

  <div class="hero__fade"></div>
</section>

<script>
  import { motion } from '../../utils/motion';

  const roles = ['Creative Developer', 'Full Stack & App Developer', 'UI & UX Designer', 'Cybersecurity Enthusiast', 'React Specialist', 'L-ubu', 'Builder of Things', 'CSS Wizard'];
  let roleIndex = 0;
  const roleEl = document.getElementById('role-text');
  let morphing = false;

  async function morphRole() {
    if (!roleEl || morphing) return;
    morphing = true;
    const next = roles[(++roleIndex) % roles.length];
    if (motion.reduced) {
      roleEl.textContent = next;
      morphing = false;
      return;
    }
    const current = roleEl.textContent || '';
    for (let i = current.length; i >= 0; i--) {
      roleEl.textContent = current.slice(0, i);
      await new Promise(r => setTimeout(r, 30));
    }
    for (let i = 0; i <= next.length; i++) {
      roleEl.textContent = next.slice(0, i);
      await new Promise(r => setTimeout(r, 50));
    }
    morphing = false;
  }

  async function roleLoop() {
    while (true) {
      await new Promise(r => setTimeout(r, 3500));
      await morphRole();
    }
  }
  roleLoop();

  const nameEl = document.querySelector('[data-name-click]');
  if (nameEl) {
    nameEl.addEventListener('click', () => {
      if (window.__nameClick) window.__nameClick();
    });
  }

  // --- Living topology / flowing wave canvas ---
  const canvas = document.getElementById('hero-particles');
  if (canvas) {
    const ctx = canvas.getContext('2d');
    let w, h, dpr;
    let mouseX = -9999, mouseY = -9999;
    let smoothMouseX = -9999, smoothMouseY = -9999;
    let time = 0;
    const LINE_COUNT = 28;
    const POINTS_PER_LINE = 150;
    const MOUSE_RADIUS = 200;
    const MOUSE_STRENGTH = 80;

    const ripples = [];

    function getAccent() {
      return getComputedStyle(document.documentElement)
        .getPropertyValue('--color-accent').trim() || '#16a34a';
    }

    function hexToRgb(hex) {
      const m = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex);
      return m ? { r: parseInt(m[1], 16), g: parseInt(m[2], 16), b: parseInt(m[3], 16) } : { r: 22, g: 163, b: 74 };
    }

    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = canvas.parentElement.offsetWidth;
      h = canvas.parentElement.offsetHeight;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function waveY(x, baseY, lineIdx, t) {
      const nx = x / w;
      const li = lineIdx / LINE_COUNT;
      const y1 = Math.sin(nx * 3.5 + t * 0.4 + lineIdx * 0.7) * 18;
      const y2 = Math.sin(nx * 7 - t * 0.25 + lineIdx * 1.3) * 8;
      const y3 = Math.sin(nx * 1.2 + t * 0.6 + li * Math.PI * 4) * 25;
      const y4 = Math.cos(nx * 5 + t * 0.15 - lineIdx * 0.4) * 5;
      const breathe = Math.sin(t * 0.2 + lineIdx * 0.3) * 12;
      return baseY + y1 + y2 + y3 + y4 + breathe;
    }

    function draw() {
      // Ambient wave motion is clock-driven (R3) — freeze it at rest. Mouse
      // push and click ripples are input-driven and keep working below.
      if (!motion.reduced) time += 0.006;
      ctx.clearRect(0, 0, w, h);

      smoothMouseX += (mouseX - smoothMouseX) * 0.08;
      smoothMouseY += (mouseY - smoothMouseY) * 0.08;

      const accent = getAccent();
      const rgb = hexToRgb(accent);
      const spacing = h / (LINE_COUNT + 1);

      for (let r = ripples.length - 1; r >= 0; r--) {
        ripples[r].radius += 3;
        ripples[r].strength *= 0.97;
        if (ripples[r].strength < 0.5) ripples.splice(r, 1);
      }

      for (let li = 0; li < LINE_COUNT; li++) {
        const baseY = spacing * (li + 1);
        const centerDist = Math.abs(li - LINE_COUNT / 2) / (LINE_COUNT / 2);
        const lineAlpha = 0.06 + (1 - centerDist) * 0.22;
        const lineWidth = 0.5 + (1 - centerDist) * 1.2;
        const isAccent = centerDist < 0.4;

        const cr = isAccent ? rgb.r : Math.round(rgb.r * 0.3 + 100);
        const cg = isAccent ? rgb.g : Math.round(rgb.g * 0.3 + 100);
        const cb = isAccent ? rgb.b : Math.round(rgb.b * 0.3 + 100);

        ctx.beginPath();
        for (let pi = 0; pi <= POINTS_PER_LINE; pi++) {
          const px = (pi / POINTS_PER_LINE) * w;
          let py = waveY(px, baseY, li, time);

          const dmx = px - smoothMouseX;
          const dmy = py - smoothMouseY;
          const dist = Math.sqrt(dmx * dmx + dmy * dmy);
          if (dist < MOUSE_RADIUS && dist > 0) {
            const push = (1 - dist / MOUSE_RADIUS);
            const pushEased = push * push * push;
            py += (dmy / dist) * pushEased * MOUSE_STRENGTH;
          }

          for (let r = 0; r < ripples.length; r++) {
            const rp = ripples[r];
            const rdx = px - rp.x;
            const rdy = py - rp.y;
            const rd = Math.sqrt(rdx * rdx + rdy * rdy);
            const ringDist = Math.abs(rd - rp.radius);
            if (ringDist < 40) {
              const wave = Math.sin((ringDist / 40) * Math.PI) * rp.strength;
              py += (rdy / (rd || 1)) * wave * 0.5;
            }
          }

          if (pi === 0) ctx.moveTo(px, py);
          else ctx.lineTo(px, py);
        }

        if (isAccent && lineWidth > 1) {
          ctx.save();
          ctx.shadowColor = `rgba(${cr}, ${cg}, ${cb}, ${lineAlpha * 0.6})`;
          ctx.shadowBlur = 8;
          ctx.strokeStyle = `rgba(${cr}, ${cg}, ${cb}, ${lineAlpha})`;
          ctx.lineWidth = lineWidth;
          ctx.stroke();
          ctx.restore();
        } else {
          ctx.strokeStyle = `rgba(${cr}, ${cg}, ${cb}, ${lineAlpha})`;
          ctx.lineWidth = lineWidth;
          ctx.stroke();
        }
      }

      if (smoothMouseX > 0 && smoothMouseX < w && smoothMouseY > 0 && smoothMouseY < h) {
        const grad = ctx.createRadialGradient(smoothMouseX, smoothMouseY, 0, smoothMouseX, smoothMouseY, MOUSE_RADIUS * 0.7);
        grad.addColorStop(0, `rgba(${rgb.r}, ${rgb.g}, ${rgb.b}, 0.04)`);
        grad.addColorStop(1, 'transparent');
        ctx.fillStyle = grad;
        ctx.fillRect(smoothMouseX - MOUSE_RADIUS, smoothMouseY - MOUSE_RADIUS, MOUSE_RADIUS * 2, MOUSE_RADIUS * 2);
      }

      requestAnimationFrame(draw);
    }

    const hero = canvas.parentElement;
    hero.addEventListener('mousemove', (e) => {
      const rect = canvas.getBoundingClientRect();
      mouseX = e.clientX - rect.left;
      mouseY = e.clientY - rect.top;
    });

    hero.addEventListener('mouseleave', () => {
      mouseX = -9999; mouseY = -9999;
    });

    hero.addEventListener('click', (e) => {
      const rect = canvas.getBoundingClientRect();
      ripples.push({
        x: e.clientX - rect.left,
        y: e.clientY - rect.top,
        radius: 0,
        strength: 30,
      });
    });

    window.addEventListener('resize', resize);
    resize();
    requestAnimationFrame(draw);
  }
</script>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
  }

  .hero__content {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 2rem;
  }

  .hero__name-wrapper {
    overflow: hidden;
    padding: 0.2em 0;
  }

  .hero__name {
    font-family: var(--font-heading);
    font-size: clamp(2.5rem, 8vw, 7rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
    cursor: pointer;
    user-select: none;
  }

  .hero__letter {
    display: inline-block;
    opacity: 0;
    transform: translateY(100%);
    animation: letterReveal 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    animation-delay: var(--delay);
  }

  @keyframes letterReveal {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  html[data-motion="reduced"] .hero__letter {
    opacity: 1;
    transform: none;
    animation: none;
  }

  .hero__subtitle {
    margin-top: 1.5rem;
    font-family: var(--font-mono);
    font-size: clamp(0.9rem, 2vw, 1.3rem);
    color: var(--color-accent);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2px;
    min-height: 2em;
  }

  .hero__cursor-blink {
    animation: blink 1s step-end infinite;
    color: var(--color-accent);
  }

  @keyframes blink {
    50% { opacity: 0; }
  }

  html[data-motion="reduced"] .hero__cursor-blink {
    animation: none;
  }

  .hero__scroll-hint {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: #555;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    animation: fadeInUp 1s ease 2s both;
    z-index: 3;
  }

  .hero__scroll-line {
    width: 1px;
    height: 40px;
    background: linear-gradient(to bottom, transparent, var(--color-accent), transparent);
    animation: scrollPulse 2s ease-in-out infinite;
  }

  .hero__scroll-hint span {
    animation: hintBounce 2s ease-in-out infinite 3s;
  }

  @keyframes scrollPulse {
    0%, 100% { opacity: 0.3; transform: scaleY(1); }
    50% { opacity: 1; transform: scaleY(1.3); }
  }

  @keyframes hintBounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(6px); }
  }

  @keyframes fadeInUp {
    from { opacity: 0; transform: translateX(-50%) translateY(20px); }
    to { opacity: 1; transform: translateX(-50%) translateY(0); }
  }

  html[data-motion="reduced"] .hero__scroll-hint {
    opacity: 1;
    transform: translateX(-50%);
    animation: none;
  }

  html[data-motion="reduced"] .hero__scroll-line {
    opacity: 1;
    transform: none;
    animation: none;
  }

  html[data-motion="reduced"] .hero__scroll-hint span {
    animation: none;
  }

  .hero__fade {
    position: absolute;
    bottom: -1px;
    left: 0;
    right: 0;
    height: 120px;
    background: linear-gradient(to bottom, transparent, var(--color-bg));
    z-index: 1;
    pointer-events: none;
  }
</style>
