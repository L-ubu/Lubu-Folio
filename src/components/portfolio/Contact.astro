---
const socials = [
  { label: 'GitHub', icon: '⟁', href: 'https://github.com/L-ubu', id: 'github' },
  { label: 'Email', icon: '✉', href: 'mailto:vandenweghe.luca@gmail.com', id: 'email' },
  { label: 'Portfolio', icon: '◆', href: 'https://luca-like.be', id: 'portfolio' },
];
---

<section id="contact" class="contact" data-section="contact">
  <div class="contact__container">
    <h2 class="contact__title scroll-reveal">
      <span data-translate="contact-title-1">Let's build</span><br/>
      <span class="accent" data-translate="contact-title-2">something cool</span>
    </h2>

    <p class="contact__subtitle scroll-reveal" style="--reveal-delay: 0.1s" data-translate="contact-subtitle">
      Got an idea? Want to collaborate? Or just want to say hi?
    </p>

    <form class="contact__form scroll-reveal" style="--reveal-delay: 0.2s" data-contact-form>
      <div class="contact__field">
        <input type="text" id="name" name="name" placeholder=" " required />
        <label for="name" data-translate="contact-name-label">Your name</label>
        <div class="contact__field-line"></div>
      </div>

      <div class="contact__field">
        <input type="email" id="email-input" name="email" placeholder=" " required />
        <label for="email-input" data-translate="contact-email-label">Your email</label>
        <div class="contact__field-line"></div>
      </div>

      <div class="contact__field">
        <textarea id="message" name="message" rows="4" placeholder=" " required></textarea>
        <label for="message" data-translate="contact-message-label">Your message</label>
        <div class="contact__field-line"></div>
      </div>

      <button type="submit" class="contact__submit" data-cursor-hover>
        <span class="contact__submit-text" data-translate="contact-send">Send message</span>
        <span class="contact__submit-arrow">→</span>
      </button>
    </form>

    <div class="mail-effect" data-mail-effect>
      <div class="mail-effect__envelope">
        <div class="mail-effect__body"></div>
        <div class="mail-effect__flap"></div>
        <div class="mail-effect__seal"></div>
      </div>
      <div class="mail-effect__trail"></div>
      <div class="mail-effect__sparks">
        <span></span><span></span><span></span><span></span><span></span>
      </div>
    </div>

    <div class="contact__socials scroll-reveal" style="--reveal-delay: 0.4s">
      {socials.map((social, i) => (
        <a
          href={social.href}
          class="contact__social"
          target="_blank"
          rel="noopener"
          data-social={social.id}
          style={`--social-delay: ${i * 0.1}s`}
        >
          <span class="contact__social-icon">{social.icon}</span>
          <span class="contact__social-label">{social.label}</span>
        </a>
      ))}
    </div>
  </div>

  <div class="contact__footer">
    <p data-translate="contact-footer">Built with obsessive attention to detail by <strong>Luca Vandenweghe</strong></p>
    <p class="contact__footer-sub" data-translate="contact-footer-sub">Astro + React + Three.js + too much Nalu</p>
    <div class="word-hint" id="word-hint">
      <span class="word-hint__icon">&#x2328;</span>
      <span class="word-hint__text">try typing something...</span>
      <span class="word-hint__counter" id="word-counter">0 / ?</span>
    </div>
  </div>
</section>

<!-- Hidden ASCII art past the footer -->
<div class="hidden-ascii" aria-hidden="true">
<pre>{`
          ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░
          ░  You scrolled too far...              ░
          ░  But since you're here:               ░
          ░         ▄████████▄                    ░
          ░      ▄██░░░░░░░░░░██▄                 ░
          ░     █░░░░██░░░░██░░░░█                ░
          ░     █░░░░░░░▄▄░░░░░░░█                ░
          ░      ██░░░░░░░░░░░░██                 ░
          ░     ▄█▀██░░░░░░░░██▀█▄                ░
          ░    █▀    ▀▀████▀▀    ▀█               ░
          ░       crafted with ♥ by L-ubu  ░
          ░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░░
`}</pre>
</div>

<script>
  const emailLink = document.querySelector('[data-social="email"]');
  if (emailLink) {
    let clicks = 0;
    emailLink.addEventListener('click', (e) => {
      clicks++;
      if (clicks >= 5) {
        e.preventDefault();
        clicks = 0;
        const msg = document.createElement('div');
        msg.textContent = '🟢 Psst... the answer to the riddle is "a die" (dice)';
        msg.style.cssText = 'position:fixed;bottom:80px;right:24px;z-index:99999;background:#111;border:1px solid var(--color-accent);border-radius:8px;padding:12px 16px;font-family:var(--font-mono);font-size:13px;color:var(--color-accent);box-shadow:0 8px 30px rgba(0,0,0,0.5);animation:fadeInUp 0.5s ease;';
        document.body.appendChild(msg);
        setTimeout(() => msg.remove(), 5000);
      }
    });
  }

  const contactForm = document.querySelector('[data-contact-form]');
  const mailEffect = document.querySelector('[data-mail-effect]');
  const FORMSPREE_ID = 'xwpkyljy';

  if (contactForm && mailEffect) {
    contactForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = contactForm.querySelector('.contact__submit');
      const btnRect = btn.getBoundingClientRect();
      const textEl = btn.querySelector('.contact__submit-text');
      const arrowEl = btn.querySelector('.contact__submit-arrow');

      mailEffect.style.setProperty('--start-x', `${btnRect.left + btnRect.width / 2}px`);
      mailEffect.style.setProperty('--start-y', `${btnRect.top + btnRect.height / 2}px`);

      btn.classList.add('contact__submit--sending');
      mailEffect.classList.add('mail-effect--active');

      const formData = new FormData(contactForm);

      try {
        const res = await fetch(`https://formspree.io/f/${FORMSPREE_ID}`, {
          method: 'POST',
          body: formData,
          headers: { Accept: 'application/json' },
        });

        if (res.ok) {
          contactForm.reset();
          btn.classList.remove('contact__submit--sending');
          btn.classList.add('contact__submit--sent');
          if (textEl) textEl.textContent = 'Sent!';
          if (arrowEl) arrowEl.textContent = '\u2713';
        } else {
          btn.classList.remove('contact__submit--sending');
          if (textEl) textEl.textContent = 'Failed \u2014 try again';
          if (arrowEl) arrowEl.textContent = '\u2717';
        }
      } catch {
        btn.classList.remove('contact__submit--sending');
        if (textEl) textEl.textContent = 'Offline \u2014 try again';
        if (arrowEl) arrowEl.textContent = '\u2717';
      }

      setTimeout(() => {
        mailEffect.classList.remove('mail-effect--active');
        btn.classList.remove('contact__submit--sent');
        if (textEl) textEl.textContent = 'Send message';
        if (arrowEl) arrowEl.textContent = '\u2192';
      }, 4000);
    });
  }

  function updateWordCounter() {
    const counter = document.getElementById('word-counter');
    if (!counter) return;
    if (window.__getWordStats) {
      const stats = window.__getWordStats();
      counter.textContent = `${stats.discovered} / ${stats.total}`;
    }
  }

  updateWordCounter();
  window.addEventListener('word-stats-ready', updateWordCounter);
  window.addEventListener('word-discovered', (e) => {
    const counter = document.getElementById('word-counter');
    if (!counter || !e.detail) return;
    counter.textContent = `${e.detail.count} / ${e.detail.total}`;
    counter.style.transition = 'transform 0.3s, color 0.3s';
    counter.style.transform = 'scale(1.3)';
    counter.style.color = 'var(--color-accent)';
    setTimeout(() => { counter.style.transform = ''; }, 400);
  });
</script>

<style>
  .contact {
    min-height: 100vh;
    padding: 8rem 2rem 4rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .contact__container {
    max-width: 600px;
    margin: 0 auto;
    width: 100%;
    text-align: center;
  }

  .contact__title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    margin-bottom: 1rem;
  }

  .contact__title .accent {
    color: var(--color-accent);
  }

  .contact__subtitle {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin-bottom: 3rem;
  }

  .contact__form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    text-align: left;
    margin-bottom: 3rem;
  }

  .contact__field {
    position: relative;
  }

  .contact__field input,
  .contact__field textarea {
    width: 100%;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 1rem;
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 0.95rem;
    outline: none;
    transition: border-color 0.3s, box-shadow 0.3s;
    resize: none;
  }

  .contact__field input:focus,
  .contact__field textarea:focus {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px var(--color-accent-dim);
  }

  .contact__field label {
    position: absolute;
    top: 1rem;
    left: 1rem;
    color: var(--color-text-muted);
    font-size: 0.95rem;
    pointer-events: none;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .contact__field input:focus + label,
  .contact__field input:not(:placeholder-shown) + label,
  .contact__field textarea:focus + label,
  .contact__field textarea:not(:placeholder-shown) + label {
    top: -0.6rem;
    left: 0.8rem;
    font-size: 0.7rem;
    color: var(--color-accent);
    background: var(--color-bg);
    padding: 0 4px;
  }

  .contact__field-line {
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 0;
    height: 2px;
    background: var(--color-accent);
    border-radius: 1px;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .contact__field input:focus ~ .contact__field-line,
  .contact__field textarea:focus ~ .contact__field-line {
    left: 0;
    width: 100%;
  }

  .contact__submit {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 1rem 2rem;
    background: var(--color-accent);
    color: var(--color-bg);
    border: none;
    border-radius: 10px;
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 600;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .contact__submit:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px var(--color-accent-dim);
  }

  .contact__submit-arrow {
    transition: transform 0.3s;
  }

  .contact__submit:hover .contact__submit-arrow {
    transform: translateX(4px);
  }

  .contact__socials {
    display: flex;
    gap: 16px;
    justify-content: center;
  }

  .contact__social {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-text-dim);
    transition: all 0.3s ease;
    text-decoration: none;
  }

  .contact__social:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    transform: translateY(-2px);
  }

  .contact__footer {
    margin-top: 6rem;
    text-align: center;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    padding-bottom: 2rem;
  }

  .contact__footer strong {
    color: var(--color-text);
  }

  .contact__footer-sub {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin-top: 0.5rem;
    opacity: 0.6;
  }

  .word-hint {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 1.2rem;
    padding: 6px 14px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 20px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-text-muted);
    opacity: 0.5;
    transition: opacity 0.3s, border-color 0.3s;
    cursor: default;
  }

  .word-hint:hover {
    opacity: 0.9;
    border-color: var(--color-accent-dim);
  }

  .word-hint__icon {
    font-size: 14px;
    opacity: 0.6;
  }

  .word-hint__text {
    letter-spacing: 0.05em;
  }

  .word-hint__counter {
    color: var(--color-accent);
    font-weight: 600;
    font-size: 0.7rem;
    padding-left: 4px;
    border-left: 1px solid rgba(255, 255, 255, 0.08);
    margin-left: 2px;
  }

  .hidden-ascii {
    text-align: center;
    color: #222;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    padding: 2rem;
    user-select: none;
    transition: color 0.5s;
  }

  .hidden-ascii:hover {
    color: var(--color-accent);
  }


  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Mail send effect */
  .mail-effect {
    position: fixed;
    left: var(--start-x, 50%);
    top: var(--start-y, 50%);
    z-index: 10000;
    pointer-events: none;
    opacity: 0;
    transform: translate(-50%, -50%) scale(0);
  }

  .mail-effect--active {
    animation: mailAppear 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards,
               mailFly 1.2s cubic-bezier(0.5, 0, 0, 1) 0.6s forwards;
  }

  .mail-effect__envelope {
    width: 64px;
    height: 44px;
    position: relative;
  }

  .mail-effect__body {
    position: absolute;
    inset: 0;
    background: var(--color-accent);
    border-radius: 4px;
    box-shadow: 0 4px 20px var(--color-accent-glow);
  }

  .mail-effect__flap {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 50%;
    background: var(--color-accent);
    filter: brightness(1.2);
    clip-path: polygon(0 0, 50% 100%, 100% 0);
    transform-origin: top center;
    border-radius: 4px 4px 0 0;
  }

  .mail-effect--active .mail-effect__flap {
    animation: flapClose 0.3s ease-in 0.2s forwards;
  }

  .mail-effect__seal {
    position: absolute;
    top: 40%;
    left: 50%;
    width: 12px;
    height: 12px;
    background: var(--color-bg);
    border-radius: 50%;
    transform: translate(-50%, -50%) scale(0);
    box-shadow: 0 0 8px var(--color-bg);
  }

  .mail-effect--active .mail-effect__seal {
    animation: sealAppear 0.2s ease-out 0.45s forwards;
  }

  .mail-effect__trail {
    position: absolute;
    top: 50%;
    right: 100%;
    width: 80px;
    height: 2px;
    background: linear-gradient(to left, var(--color-accent), transparent);
    opacity: 0;
    transform: translateY(-50%);
  }

  .mail-effect--active .mail-effect__trail {
    animation: trailShow 0.8s ease-out 0.65s forwards;
  }

  .mail-effect__sparks span {
    position: absolute;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-accent);
    opacity: 0;
  }

  .mail-effect--active .mail-effect__sparks span:nth-child(1) {
    animation: spark 0.6s ease-out 0.6s forwards;
    --sx: -30px; --sy: -25px;
  }
  .mail-effect--active .mail-effect__sparks span:nth-child(2) {
    animation: spark 0.6s ease-out 0.65s forwards;
    --sx: 25px; --sy: -30px;
  }
  .mail-effect--active .mail-effect__sparks span:nth-child(3) {
    animation: spark 0.6s ease-out 0.55s forwards;
    --sx: -20px; --sy: 25px;
  }
  .mail-effect--active .mail-effect__sparks span:nth-child(4) {
    animation: spark 0.6s ease-out 0.7s forwards;
    --sx: 30px; --sy: 20px;
  }
  .mail-effect--active .mail-effect__sparks span:nth-child(5) {
    animation: spark 0.6s ease-out 0.62s forwards;
    --sx: -10px; --sy: -35px;
  }

  @keyframes mailAppear {
    0% { opacity: 0; transform: translate(-50%, -50%) scale(0) rotate(-10deg); }
    100% { opacity: 1; transform: translate(-50%, -50%) scale(1) rotate(0deg); }
  }

  @keyframes mailFly {
    0% { transform: translate(-50%, -50%) scale(1) rotate(0deg); }
    30% { transform: translate(-50%, -80%) scale(1.1) rotate(-5deg); }
    100% { transform: translate(calc(50vw - 50%), -120vh) scale(0.3) rotate(-20deg); opacity: 0; }
  }

  @keyframes flapClose {
    0% { transform: rotateX(0deg); }
    100% { transform: rotateX(180deg); }
  }

  @keyframes sealAppear {
    0% { transform: translate(-50%, -50%) scale(0); }
    100% { transform: translate(-50%, -50%) scale(1); }
  }

  @keyframes trailShow {
    0% { opacity: 0; width: 0; }
    40% { opacity: 0.8; width: 80px; }
    100% { opacity: 0; width: 120px; }
  }

  @keyframes spark {
    0% { opacity: 1; transform: translate(0, 0) scale(1); }
    100% { opacity: 0; transform: translate(var(--sx), var(--sy)) scale(0); }
  }

  .contact__submit--sending {
    transform: scale(0.95);
    opacity: 0.7;
    pointer-events: none;
  }

  .contact__submit--sent {
    background: #16a34a;
    pointer-events: none;
  }
</style>
