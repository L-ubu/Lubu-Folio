---
import LanguageSwitcher from './LanguageSwitcher.jsx';

const facts = [
  { emoji: '🇧🇪🇵🇪', label: 'Belgian-Peruvian' },
  { emoji: '⚛️', label: 'React Developer @ iO Digital' },
  { emoji: '🎨', label: 'UI & UX Design' },
  { emoji: '🔐', label: 'Cybersecurity & Pentesting' },
  { emoji: '🧗', label: 'Boulderer' },
  { emoji: '🏄', label: 'Surfer' },
  { emoji: '🛹', label: 'Longboarder' },
  { emoji: '🎮', label: 'Gamer — MrGreenSlime' },
  { emoji: '🎲', label: 'DND Worldbuilder' },
  { emoji: '⚜️', label: 'Scout Leader' },
];

---

<section id="about" class="about" data-section="about">
  <div class="about__container">
    <h2 class="about__title scroll-reveal">
      <span class="about__title-line" data-translate="about-title-1">I build things</span>
      <span class="about__title-line accent" data-translate="about-title-2">for the web</span>
      <span class="about__title-line dim" data-translate="about-title-3">and beyond.</span>
    </h2>

    <div class="about__body">
      <div class="about__text">
        <p class="scroll-reveal" style="--reveal-delay: 0.1s" data-translate="about-bio-1">
          I'm a 24-year-old Full Stack & App Developer from Belgium with Peruvian roots.
          I create secure, beautiful, and functional digital experiences — through
          animation, interaction, and obsessive attention to the details that make
          people go "wait, how?"
        </p>
        <p class="scroll-reveal" style="--reveal-delay: 0.2s" data-translate="about-bio-2">
          By day I build React/TypeScript applications at <strong>iO Digital</strong> in Ghent
          for the Jaguar Land Rover MSS project. By night I'm working on one of my
          many side projects, climbing a wall somewhere, or gaming with my girlfriend Vale.
        </p>
        <p class="scroll-reveal" style="--reveal-delay: 0.3s" data-translate="about-bio-3">
          I studied Electronics-ICT at <strong>Odisee</strong> with a specialization in
          Web & App Development. I'm also into cybersecurity, CTFs, and pentesting.
          I have ADD, which means I have 47 ideas per minute and finish approximately
          3 per year. But the ones I finish? Those are pretty cool.
        </p>
      </div>

      <div class="about__facts">
        {facts.map((fact, i) => (
          <div
            class="about__fact scroll-reveal"
            style={`--reveal-delay: ${0.1 + i * 0.05}s`}
          >
            <span class="about__fact-emoji">{fact.emoji}</span>
            <span class="about__fact-label">{fact.label}</span>
          </div>
        ))}
      </div>
    </div>

    <div class="scroll-reveal" style="--reveal-delay: 0.5s">
      <LanguageSwitcher client:visible />
    </div>
  </div>
</section>

<style>
  .about {
    min-height: 100vh;
    padding: 8rem 2rem;
    display: flex;
    align-items: center;
    position: relative;
  }

  .about__container {
    max-width: 1100px;
    margin: 0 auto;
    width: 100%;
  }

  .about__title {
    font-size: clamp(2rem, 6vw, 4.5rem);
    margin-bottom: 4rem;
  }

  .about__title-line {
    display: block;
  }

  .about__title-line.accent {
    color: var(--color-accent);
  }

  .about__title-line.dim {
    color: var(--color-text-dim);
  }

  .about__body {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  @media (max-width: 768px) {
    .about__body {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }

  .about__text p {
    font-size: 1.1rem;
    line-height: 1.8;
    color: var(--color-text-dim);
    margin-bottom: 1.5rem;
  }

  .about__text strong {
    color: var(--color-text);
    font-weight: 600;
  }

  .about__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .about__fact {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 16px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font-size: 0.85rem;
    color: var(--color-text-dim);
    transition: all 0.3s ease;
  }

  .about__fact:hover {
    border-color: var(--color-accent);
    color: var(--color-text);
    transform: translateY(-2px);
    box-shadow: 0 4px 20px var(--color-accent-dim);
  }

  .about__fact-emoji {
    font-size: 1.1rem;
  }


</style>
