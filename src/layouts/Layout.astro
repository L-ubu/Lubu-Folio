---
import DevConsole from '../components/shared/DevConsole.jsx';
const { title = "Luca Vandenweghe | Creative Developer", description = "Multi-mode portfolio of Luca Vandenweghe — creative developer, MrGreenSlime, builder of weird and wonderful things." } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Luca Vandenweghe" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#050505" />
    <script is:inline>
      (function () {
        var mq = window.matchMedia("(prefers-reduced-motion: reduce)");
        var apply = function (reduced) {
          document.documentElement.dataset.motion = reduced ? "reduced" : "normal";
        };
        apply(mq.matches);
        mq.addEventListener("change", function (e) {
          apply(e.matches);
        });
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <script>
      import { initAccentColor } from '../utils/storage.js';
      initAccentColor();
    </script>
  </head>
  <body>
    <slot />
    <DevConsole client:only="react" />
    <script>
      import { prefersReducedMotion } from '../utils/motion.js';

      console.log(`
%c
  ██╗     ██╗   ██╗ ██████╗ █████╗
  ██║     ██║   ██║██╔════╝██╔══██╗
  ██║     ██║   ██║██║     ███████║
  ██║     ██║   ██║██║     ██╔══██║
  ███████╗╚██████╔╝╚██████╗██║  ██║
  ╚══════╝ ╚═════╝  ╚═════╝╚═╝  ╚═╝

  Looking for secrets? You found one! 🟢
  There are more hidden throughout. Good luck.

  — MrGreenSlime
`, 'color: #3b82f6; font-family: monospace;');
      console.log('%cFLAG{console_cowboy}', 'color: #5ccfcf; font-size: 14px; font-weight: bold; font-family: monospace;');

      document.cookie = 'session_token=FLAG{cookie_monster}; path=/; SameSite=Lax';
      if (!localStorage.getItem('_ctf_seed')) localStorage.setItem('_ctf_seed', 'FLAG{local_storage_lurker}');

      let konamiSeq = [];
      const konamiCode = [38,38,40,40,37,39,37,39,66,65];
      document.addEventListener('keydown', (e) => {
        konamiSeq.push(e.keyCode);
        if (konamiSeq.length > 10) konamiSeq.shift();
        if (konamiSeq.join(',') === konamiCode.join(',')) {
          console.log('%cFLAG{konami_legend}', 'color: #6ec87a; font-size: 16px; font-weight: bold;');
          document.title = '🏴 FLAG{konami_legend}';
          setTimeout(() => document.title = baseTitle, 5000);
        }
      });

      // Animated page title effect — skipped entirely under prefers-reduced-motion
      const baseTitle = document.title;
      const glitchChars = '░▒▓█▀▄╔╗╚╝║═╬┼';
      const frames = ['◐', '◓', '◑', '◒'];
      const awayMessage = '👀 come back...';
      let titleFrame = 0;
      let titleIntervalId = null;

      function animateTitle() {
        titleFrame++;

        if (titleFrame < 40) {
          const progress = Math.floor((titleFrame / 40) * baseTitle.length);
          let glitched = '';
          for (let i = 0; i < baseTitle.length; i++) {
            if (i < progress) {
              glitched += baseTitle[i];
            } else if (i < progress + 3) {
              glitched += glitchChars[Math.floor(Math.random() * glitchChars.length)];
            } else {
              glitched += ' ';
            }
          }
          document.title = glitched;
        } else if (titleFrame < 50) {
          document.title = baseTitle;
        } else {
          const spinner = frames[Math.floor(titleFrame / 8) % frames.length];
          document.title = `${spinner} ${baseTitle}`;
          if (titleFrame > 200) titleFrame = 50;
        }
      }

      function startTitleAnimation() {
        if (titleIntervalId !== null) return;
        titleIntervalId = setInterval(animateTitle, 400);
      }

      function stopTitleAnimation() {
        if (titleIntervalId === null) return;
        clearInterval(titleIntervalId);
        titleIntervalId = null;
      }

      if (!prefersReducedMotion()) {
        startTitleAnimation();

        document.addEventListener('visibilitychange', () => {
          if (document.hidden) {
            stopTitleAnimation();
            document.title = awayMessage;
          } else {
            titleFrame = 40;
            document.title = baseTitle;
            startTitleAnimation();
          }
        });

        window.addEventListener('pagehide', stopTitleAnimation);
      }
    </script>
    <!-- If you're reading this source, you're a curious one.
         Here's a riddle: I have 6 faces but no body,
         21 eyes but cannot see. What am I? -->
    <div data-flag="FLAG{inspect_element}" style="display:none" aria-hidden="true"></div>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
